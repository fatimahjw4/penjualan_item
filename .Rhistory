# SIMULASI MONTE CARLO PENJUALAN ROTI
# 1. Data hasil cleaning Google Colab
kondisi <- c("Sepi", "Sedang", "Ramai")
frekuensi <- c(149, 301, 150)
rata_item <- c(306.100671, 511.980066, 1068.486667)
# 2. Probabilitas dan interval bilangan acak
prob_asli <- frekuensi / sum(frekuensi)
prob <- round(prob_asli, 2)
kumulatif <- cumsum(prob)
batas <- cumsum(prob * 100)
tabel <- data.frame(
Kondisi = kondisi,
Frekuensi = frekuensi,
Probabilitas_Asli = round(prob_asli, 6),
Probabilitas = prob,
Kumulatif = kumulatif,
Interval = paste(c(1, head(batas, -1) + 1), batas, sep = "-")
)
cat("\n=== TABEL PROBABILITAS ===\n")
print(tabel, row.names = FALSE)
# 3. Simulasi penjualan harian (1000 percobaan)
set.seed(2026)
n <- 1000
acak <- sample(1:100, n, replace = TRUE)
indeks <- findInterval(acak - 1, c(0, batas[-3])) + 1
# Menentukan kondisi dari angka acak
indeks <- ifelse(acak <= batas[1], 1,
ifelse(acak <= batas[2], 2, 3))
hasil_item <- rata_item[indeks]
hasil_kondisi <- factor(kondisi[indeks], levels = kondisi)
frekuensi_simulasi <- table(hasil_kondisi)
cat("\n=== HASIL SIMULASI HARIAN ===\n")
cat("Rata-rata simulasi:", round(mean(hasil_item), 2), "item/hari\n")
cat("Rata-rata teoritis:", round(sum(prob * rata_item), 2), "item/hari\n")
cat("Rata-rata historis:", round(sum(prob_asli * rata_item), 2), "item/hari\n")
print(frekuensi_simulasi)
# 4. Simulasi total penjualan 30 hari (1000 skenario)
set.seed(2027)
hari <- 30
skenario <- 1000
acak_30 <- matrix(sample(1:100, hari * skenario, replace = TRUE),
nrow = skenario)
indeks_30 <- ifelse(acak_30 <= batas[1], 1,
ifelse(acak_30 <= batas[2], 2, 3))
total_30 <- rowSums(matrix(rata_item[indeks_30], nrow = skenario))
cat("\n=== HASIL SIMULASI 30 HARI ===\n")
cat("Rata-rata total:", round(mean(total_30)), "item\n")
cat("Minimum:", round(min(total_30)), "item\n")
cat("Maksimum:", round(max(total_30)), "item\n")
cat("Nilai teoritis:", round(hari * sum(prob * rata_item)), "item\n")
# 5. Fungsi membuat dua grafik
buat_grafik <- function() {
par(mfrow = c(1, 2), mar = c(5, 4, 4, 1))
# Grafik 1: Frekuensi kondisi
posisi <- barplot(
frekuensi_simulasi,
main = "Frekuensi Kondisi Penjualan",
xlab = "Kondisi",
ylab = "Frekuensi",
col = c("lightblue", "lightgreen", "salmon"),
ylim = c(0, max(frekuensi_simulasi) * 1.2)
)
text(posisi, as.numeric(frekuensi_simulasi),
labels = as.numeric(frekuensi_simulasi), pos = 3)
# Grafik 2: Total penjualan 30 hari
hist(
total_30,
main = "Total Penjualan Selama 30 Hari",
xlab = "Total Item Terjual",
ylab = "Frekuensi Skenario",
col = "lightblue",
border = "white"
)
abline(v = mean(total_30), col = "red", lwd = 2)
}
# 6. Menampilkan grafik di RStudio
buat_grafik()
# 7. Menyimpan kedua grafik dalam satu file PNG
png("grafik_monte_carlo.png", width = 1400, height = 600, res = 120)
buat_grafik()
dev.off()
cat("\nGrafik berhasil disimpan: grafik_monte_carlo.png\n")
